# ---- Backend environment template ----
# Copy to backend/.env and fill in real values on the server. NEVER commit .env.

# Django core
SECRET_KEY=generate-a-unique-50-char-random-string
DEBUG=False
# Comma-separated hosts/domains this backend answers on (no scheme).
ALLOWED_HOSTS=56.228.6.74,ec2-56-228-6-74.eu-north-1.compute.amazonaws.com

# Database — leave empty to use local SQLite; set to a Postgres URL in prod, e.g.
# DATABASE_URL=postgres://USER:PASS@HOST:5432/DBNAME
DATABASE_URL=

# CORS: origins (scheme://host[:port]) allowed to call the API from a browser.
# If the frontend is served same-origin via nginx (recommended), CORS is not even
# needed. List the real frontend origin(s) here if it is hosted separately.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CSRF trusted origins (scheme://host) — needed for the Django admin behind a proxy.
CSRF_TRUSTED_ORIGINS=http://56.228.6.74,http://ec2-56-228-6-74.eu-north-1.compute.amazonaws.com

# Set True ONLY when served over HTTPS (enables SSL redirect, HSTS, secure cookies).
SECURE_SSL=False

# Email (optional)
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=hello@axionforge.in

# Payments (optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google Sheets sync (optional). Leave GOOGLE_SHEET_ID empty to run DB-only.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_WORKSHEET=Applications
# Provide ONE: a path to the JSON key file, OR the JSON contents inline (one line).
# On Linux/AWS prefer the inline JSON var (no file to upload).
GOOGLE_SHEETS_CREDENTIALS=
GOOGLE_SHEETS_CREDENTIALS_JSON=
