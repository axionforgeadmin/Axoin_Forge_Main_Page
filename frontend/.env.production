# Used automatically by `npm run build` (Vite production mode).
# Relative "/api" means the built site calls the API on its OWN origin — the
# recommended setup where nginx serves this build and reverse-proxies /api to
# gunicorn (no CORS needed). If the backend is on a DIFFERENT origin instead,
# set the absolute URL here (e.g. https://api.axionforge.in/api) and add that
# frontend origin to the backend's CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=/api
